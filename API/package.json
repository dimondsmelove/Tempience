{
	"name": "@chronograph/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"start": "tsx --env-file=.env src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"db:migrate-scope-traces": "tsx --env-file=.env src/db/migrate-links-to-scope-traces.ts",
		"db:migrate-legacy-scopes": "tsx --env-file=.env src/db/migrate-legacy-scopes.ts",
		"db:drop-legacy-tables": "tsx --env-file=.env src/db/drop-legacy-tables.ts"
	},
	"dependencies": {
		"@chronograph/shared": "*",
		"@hono/node-server": "^1.19.9",
		"better-sqlite3": "^12.6.2",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.6",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.19.15",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
