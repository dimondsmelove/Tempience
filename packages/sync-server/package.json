  "type": "module",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimondsmelove/Tempience.git",
    "directory": "packages/sync-server"
  },
  "homepage": "https://github.com/dimondsmelove/Tempience/blob/main/SYNC.md",
  "bugs": "https://github.com/dimondsmelove/Tempience/issues",
  "keywords": [
    "tempience",
    "sync",
    "triplit",
    "local-first",
    "tailscale"
  ],
  "bin": {
    "tempience-sync": "bin/tempience-sync.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
