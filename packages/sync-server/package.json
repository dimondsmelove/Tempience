  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@triplit/server": "^1.1.8",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.0"
  }
