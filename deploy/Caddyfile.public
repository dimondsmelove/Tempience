{
	admin off
	auto_https off
}

http://:{$TEMPIENCE_PUBLIC_PORT:4177} {
	bind 127.0.0.1
	root * "{$TEMPIENCE_PUBLIC_ROOT}"
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		respond 404
	}

	handle /packs/* {
		header Cache-Control "no-store"
		file_server
	}

	handle /_app/immutable/* {
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx 304
		}
		file_server
	}

	@pages path / /index.html /time /time/ /pair /pair/
	handle @pages {
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
