# Dev: leave empty — Vite proxies /api → http://localhost:3100
PUBLIC_API_URL=

# Or point directly at API (Capacitor / no proxy):
# PUBLIC_API_URL=http://localhost:3100

# Production web preview: leave empty — `/api` is proxied to local API :3100
# Capacitor / no proxy: set PUBLIC_API_URL=https://your-api-host

# Local-first Triplit sync. Pair each browser at /pair; the device JWT is stored locally.
PUBLIC_TRIPLIT_SERVER_URL=https://sync.example.com

# Public release: npm run build:public (no sync, output build-public/).
# Owner builds retain the /time and legacy routes and configured sync.
