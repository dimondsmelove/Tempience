{
	"name": "chronograph-svelte",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "npm run tokens:check && node scripts/prepare-data-packs.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run tokens:check",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prelint": "npm run tokens:check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tokens:generate": "node scripts/generate-theme-tokens.mjs",
		"tokens:check": "node scripts/generate-theme-tokens.mjs --check",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"cap:sync": "npm run build && npx cap sync",
		"cap:ios": "npm run cap:sync && npx cap open ios",
		"cap:android": "npm run cap:sync && npx cap open android",
		"dev:lan": "vite dev --host 0.0.0.0 --port 5173",
		"build:public": "PUBLIC_BUILD=1 PUBLIC_TRIPLIT_SERVER_URL= PUBLIC_DATA_PACKS= npm run build",
		"check:public": "PUBLIC_BUILD=1 svelte-kit sync && svelte-check --tsconfig ./tsconfig.public.json",
		"predev": "node scripts/prepare-data-packs.mjs development",
		"predev:lan": "node scripts/prepare-data-packs.mjs development",
		"icons:generate": "node scripts/generate-icons.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/mcp": "^0.1.25",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@capacitor/android": "^8.4.1",
		"@capacitor/cli": "^8.4.1",
		"@capacitor/core": "^8.4.1",
		"@capacitor/ios": "^8.4.1",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "^8.0.2",
		"@chronograph/shared": "file:../packages/shared",
		"@fontsource/commissioner": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@sjsf/ajv8-validator": "3.8.1",
		"@sjsf/basic-theme": "3.8.1",
		"@sjsf/form": "3.8.1",
		"@triplit/client": "^1.0.50",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"i18next": "26.4.2",
		"temporal-polyfill": "^0.3.2",
		"tslib": "^2.8.1"
	}
}
